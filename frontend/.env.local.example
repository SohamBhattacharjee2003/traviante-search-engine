# URL of the FastAPI backend. Server-only — never exposed to the browser.
# Local dev:
BACKEND_URL=http://localhost:8000
# Production (HuggingFace Space):
# BACKEND_URL=https://your-username-traviante-search.hf.space

# Shared secret sent to the backend as the x-frontend-key header.
# Must match API_KEY in the backend .env.
BACKEND_API_KEY=dev-frontend-key
