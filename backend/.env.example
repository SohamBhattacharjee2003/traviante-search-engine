# ── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://traviante.com

# Shared secret the Next.js proxy sends; admin key guards write endpoints.
API_KEY=dev-frontend-key
ADMIN_API_KEY=dev-admin-key

# ── CLIP ───────────────────────────────────────────────────────
CLIP_MODEL_NAME=ViT-B/32
# CLIP_DEVICE options: auto | cpu | cuda  (no inline comments — the value is read verbatim)
CLIP_DEVICE=auto

# ── Pinecone ───────────────────────────────────────────────────
# Leave blank to run in mock mode (in-memory brute-force search).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=traviante-destinations
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Supabase ───────────────────────────────────────────────────
# Leave blank to run in mock mode (bundled sample catalog).
SUPABASE_URL=
SUPABASE_KEY=

# ── Conversational AI (Groq) ───────────────────────────────────
# Free, OpenAI-compatible LLM API (https://console.groq.com/keys).
# Leave GROQ_API_KEY blank to run the concierge in offline NLU mode —
# it still understands preferences and searches, just with templated replies.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
